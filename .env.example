APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production: set APP_ENV=production and APP_DEBUG=false â€” never expose stack
# traces / debug output on a live site.
APP_DEBUG=true
# Keep the debug toolbar off â€” it intercepts every query/view and makes the
# Filament admin laggy. Flip to true only when you need to inspect requests.
DEBUGBAR_ENABLED=false
APP_URL=http://localhost

# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-* headers.
# '*' (default) trusts the immediate upstream - correct on Render, whose
# load-balancer IPs are not published. Narrow this on self-hosted setups.
# TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Observability: human file + structured JSON file + the in-admin DB table.
LOG_STACK=single,structured,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Minimum level persisted to the app_logs DB table (raise to "warning" if noisy).
LOG_DB_LEVEL=info
LOG_DB_RETENTION_DAYS=7

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Production (e.g. TiDB Serverless): switch DB_CONNECTION to "mysql" and fill
# these in from your database provider's dashboard. TiDB Serverless requires
# TLS â€” MYSQL_ATTR_SSL_CA must point to a CA bundle (the Dockerfile installs
# ca-certificates at /etc/ssl/certs/ca-certificates.crt).
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=4000
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Secret for the /cron/run-schedule/{token} route â€” generate a random string
# and use the SAME value in your external cron pinger (e.g. cron-job.org) URL.
# Only needed on hosts with no native cron (e.g. Render's free tier).
# CRON_SECRET=

# Required before running `php artisan db:seed` on a fresh database â€” there is
# no fallback default (the seeder source is on a public repo, so a default
# password would be a public backdoor). Run db:seed once manually for initial
# setup only; it is NOT part of the automated deploy.
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set to true so the session cookie is only sent over HTTPS.
# Leave null locally (plain http://*.test). Cookies are already http_only + lax.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

