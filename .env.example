APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production: set APP_ENV=production and APP_DEBUG=false â€” never expose stack
# traces / debug output on a live site.
APP_DEBUG=true
# Keep the debug toolbar off â€” it intercepts every query/view and makes the
# Filament admin laggy. Flip to true only when you need to inspect requests.
DEBUGBAR_ENABLED=false
APP_URL=http://localhost

# Set ONLY on a redirect-stub deployment (e.g. an old Render service whose URL is
# printed on QR codes): every request 302s to this host, preserving path+query,
# without booting the app. Leave unset on the real site. See docs/REDEPLOY_CHECKLIST.md.
# REDIRECT_TO=https://your-new-site.onrender.com

# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-* headers.
# '*' (default) trusts the immediate upstream - correct on Render, whose
# load-balancer IPs are not published. Narrow this on self-hosted setups.
# TRUSTED_PROXIES=

# Malaysia local time - drives the booking calendar day boundaries, same-day
# slot filtering, and every displayed timestamp.
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Observability: human file + structured JSON file + the in-admin DB table.
LOG_STACK=single,structured,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Minimum level persisted to the app_logs DB table (raise to "warning" if noisy).
LOG_DB_LEVEL=info
LOG_DB_RETENTION_DAYS=7
# Hours of silence before an unresolved error log is auto-marked fixed.
LOG_AUTO_RESOLVE_HOURS=48

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Production (e.g. TiDB Serverless): switch DB_CONNECTION to "mysql" and fill
# these in from your database provider's dashboard. TiDB Serverless requires
# TLS â€” MYSQL_ATTR_SSL_CA must point to a CA bundle (the Dockerfile installs
# ca-certificates at /etc/ssl/certs/ca-certificates.crt).
# DB_CONNECTION=mysql
# DB_HOST=
# DB_PORT=4000
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Owner alerts (new booking / order / cancellation) are addressed to a
# "+alerts" alias of STORE_EMAIL by default, so a Gmail filter on that alias
# can label them (self-sent mail never reaches the Gmail inbox). Set this to
# route the alerts to a different mailbox instead.
# STORE_ALERT_EMAIL=

# Secret for the /cron/run-schedule/{token} route â€” generate a random string
# and use the SAME value in your external cron pinger (e.g. cron-job.org) URL.
# Only needed on hosts with no native cron (e.g. Render's free tier).
# CRON_SECRET=

# Required before running `php artisan db:seed` on a fresh database â€” there is
# no fallback default (the seeder source is on a public repo, so a default
# password would be a public backdoor). Run db:seed once manually for initial
# setup only; it is NOT part of the automated deploy.
# DEFAULT_ADMIN_EMAIL=
# DEFAULT_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: set to true so the session cookie is only sent over HTTPS.
# Leave null locally (plain http://*.test). Cookies are already http_only + lax.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ─── Stripe (TEST mode only) ───────────────────────────────────
# Sandbox keys from dashboard.stripe.com. The account country must be Malaysia
# for FPX + GrabPay to be available in test mode; card works on any account.
# Payment routing is controlled by the PAYMENT_MODE setting in the admin panel
# ('demo' by default; set to 'stripe' to route card/FPX/GrabPay through Stripe).
# Only sk_test_ secrets are accepted — live keys are ignored by design.
# Local webhooks: stripe listen --forward-to localhost:8000/stripe/webhook
# (webhook optional locally — the success-URL return also verifies payment).
# STRIPE_KEY=pk_test_...
# STRIPE_SECRET=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── SEO ───────────────────────────────────────────────────────
# Optional Google Search Console meta-tag verification. The site is already
# verified via the public/google*.html file, so this is only needed if you
# additionally use the HTML-tag verification method (config/seotools.php reads
# it into a <meta name="google-site-verification"> tag).
# GOOGLE_SITE_VERIFICATION=
