' ============================================================
'  Use Case Diagrams (PlantUML) — Win Win Car Audio
'  Render at https://www.plantuml.com/plantuml or planttext.com,
'  or with the "PlantUML" VS Code extension.
'  An actor generalization arrow (child --|> parent) means the
'  child actor ALSO has every use case of the parent, so shared
'  use cases are drawn once on the parent.
' ============================================================

' ---------- Figure 4.3: Storefront (Guest / Registered Customer) ----------
@startuml Storefront
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Guest" as G
actor "Registered\nCustomer" as C
C --|> G

rectangle "Win Win Storefront" {
  usecase "Browse products" as S1
  usecase "Use 3D configurator" as S2
  usecase "View services" as S3
  usecase "Submit contact form" as S4
  usecase "Chat with chatbot" as S5
  usecase "Track order / booking\nby reference" as S6
  usecase "Register" as S7
  usecase "Log in" as S8

  usecase "Manage profile" as S9
  usecase "Enable 2FA" as S10
  usecase "Add to cart" as S11
  usecase "Checkout\n(delivery or pickup)" as S12
  usecase "Pay online" as S13
  usecase "View order &\nbooking history" as S14
  usecase "Copy reference numbers" as S15
  usecase "Cancel own\norder or booking" as S16
  usecase "Review a delivered product\n(verified purchase)" as S17
}

G --> S1
G --> S2
G --> S3
G --> S4
G --> S5
G --> S6
G --> S7
G --> S8

C --> S9
C --> S10
C --> S11
C --> S12
C --> S13
C --> S14
C --> S15
C --> S16
C --> S17
@enduml


' ---------- Figure 4.4: Admin Panel (Staff / Admin / Owner) ----------
@startuml Admin
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Staff" as ST
actor "Admin" as AD
actor "Owner" as OW
AD --|> ST
OW --|> AD

rectangle "Admin Panel" {
  usecase "Log in to admin panel" as A1
  usecase "Confirm / edit /\nreschedule bookings" as A2
  usecase "Open order details" as A3
  usecase "Mark orders paid / ready /\nshipped / delivered" as A4
  usecase "Cancel orders &\nprocess refunds" as A5
  usecase "Import product &\norder data" as A6
  usecase "Create & edit products" as A7
  usecase "Curate homepage\ntestimonials" as A8
  usecase "Work the contact inbox" as A9

  usecase "Delete records" as A10
  usecase "Export data" as A11
  usecase "Manage categories,\nbrands, services" as A12
  usecase "Manage FAQ &\nchatbot knowledge base" as A13
  usecase "Manage settings" as A14
  usecase "Manage staff accounts" as A15
  usecase "Monitor dashboard, activity log,\nerror log, system status" as A16

  usecase "Assign roles" as A17
  usecase "Administer admin accounts" as A18
  usecase "Permanently force-delete" as A19
  usecase "Create / delete\nSetting keys" as A20
}

ST --> A1
ST --> A2
ST --> A3
ST --> A4
ST --> A5
ST --> A6
ST --> A7
ST --> A8
ST --> A9

AD --> A10
AD --> A11
AD --> A12
AD --> A13
AD --> A14
AD --> A15
AD --> A16

OW --> A17
OW --> A18
OW --> A19
OW --> A20
@enduml
